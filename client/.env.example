# Access key that powers the Contact Us form (it sends submissions to your
# inbox via Web3Forms — see src/lib/contactForm.js for the full setup steps).
#
# Get a free key instantly at https://web3forms.com — just enter the email
# address that should receive enquiries, no account required.
#
# 1. Copy this file to .env in this same folder (client/.env)
# 2. Paste your key below
# 3. npm run build
REACT_APP_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Optional: powers LIVE Google ratings/review counts on properties that
# have a googlePlaceId set in src/data/listings.js (see src/lib/googlePlaces.js
# for full setup steps). Leave blank to just use the ratings you type by
# hand in listings.js — nothing breaks either way.
REACT_APP_GOOGLE_MAPS_API_KEY=

# If your host forces the value above to uppercase (breaks the key, since
# it's case-sensitive), use this hex-encoded version instead — see the
# instructions in src/lib/googlePlaces.js for how to generate it.
REACT_APP_GOOGLE_MAPS_API_KEY_HEX=
