# Production-build-only settings (npm run build). Does not affect npm start.
#
# Skips generating the .js.map source map file in the production build.
# Source maps aren't needed by visitors (browsers only fetch them if
# someone opens DevTools with source maps enabled), and leaving them out
# keeps the build smaller and avoids publishing readable original source
# structure alongside the minified bundle.
GENERATE_SOURCEMAP=false
